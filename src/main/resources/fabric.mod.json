{
  "schemaVersion": 1,
  "id": "simpleportals",
  "version": "${version}",

  "name": "Simple Portals",
  "description": "Adds portals for easy intra- and interdimensional travel.",
  "authors": [
    "Zarathul"
  ],
  "contact": {
    "homepage": "https://github.com/Zarathul/simpleportals_fabric/",
    "sources": "https://github.com/Zarathul/simpleportals_fabric/"
  },

  "license": "MIT",
  "icon": "assets/simpleportals/logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.zarathul.simpleportals.SimplePortals"
    ],
    "client": [
      "net.zarathul.simpleportals.ClientInit"
    ]
  },
  "mixins": [
    "simpleportals.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
	"simplemodslib": "1.0.0"
  }
}
